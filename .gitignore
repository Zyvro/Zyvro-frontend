# Dependencies
node_modules/

# Next.js build output
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Local environment. NEXT_PUBLIC_API_URL points at whichever backend this
# machine runs, so it is per-developer rather than shared.
.env
.env.local
.env.*.local

# Editor and OS noise
.DS_Store
*.log
npm-debug.log*
.vscode/
.idea/

# Écrits par `next dev` lui-même, pas par nous.
#
# Éteints à la source — `agentRules: false` dans next.config.js — donc ces deux
# lignes sont le filet, pas la serrure : si ce réglage change de nom en montant
# de version, l'arbre ne redevient pas sale en silence. C'est déjà arrivé une
# fois, et le bruit est entré dans un commit qui parlait d'autre chose.
AGENTS.md
CLAUDE.md
